{
  "expo": {
    "name": "proteia",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-image.png",
      "resizeMode": "cover",
      "backgroundColor": "#FAF6F1"
    },
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "projectId": "protea-6b85c",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Snap meal photos to log protein",
        "NSPhotoLibraryUsageDescription": "Pick meal photos to log protein",
        "NSMotionUsageDescription": "Allow $(PRODUCT_NAME) to track movement and physical activity",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone"
      },
      "bundleIdentifier": "com.protea.app",
      "buildNumber": "8"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#faf6f1"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "com.android.vending.BILLING"
      ],
      "package": "com.protea.app",
      "versionCode": 4
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "resizeMode": "cover",
          "backgroundColor": "#FAF6F1"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Snap meal photos to log protein",
          "photosPermission": "Pick meal photos to log protein",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2267c16b-f696-472e-9376-d273f2dcd4be"
      }
    },
    "owner": "muhammadali222"
  }
}